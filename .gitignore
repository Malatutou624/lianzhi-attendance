# ---------- 依赖与构建产物（不需要提交，别人 npm install / mvn 就能生成）----------
node_modules/
dist/
target/
*.class

# ---------- 上传的文件（人脸照片、打卡照片，含隐私，不要传到公开仓库）----------
uploads/

# ---------- 虹软 ArcFace SDK 运行时（平台相关二进制，同学自行下载）----------
server/arcsoft/
*.dat

# ---------- IDE 与编辑器配置 ----------
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ---------- 日志与临时文件 ----------
*.log
logs/
.DS_Store
Thumbs.db

# ---------- 误建的空 Git 仓库 ----------
/lianzhi/

# ---------- 知识库临时生成/运行时 ----------
server/knowledge/docs-out/node_modules/
server/knowledge/docs-out/*.js
server/knowledge/docs-out/package.json
server/knowledge/docs-out/package-lock.json

# ---------- 本地敏感配置（含 API Key，绝对不要推到 GitHub）----------
server/src/main/resources/application.yml

# ---------- 本地 Docker 临时脚本 ----------
tmp-*.py
tmp-*.js
tmp-*.sh
package-lock.json
package.json
